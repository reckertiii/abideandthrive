# Copy to .env and fill in. Never commit .env.
PORT=3000
# Public URL of the site (used for Square checkout return links)
SITE_URL=http://localhost:3000

# Admin account created on first run. If ADMIN_PASSWORD is blank, a random one is printed to the console.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Email via Resend (resend.com). Leave blank to just print emails to the console while testing.
RESEND_API_KEY=
MAIL_FROM=Abide & Thrive <hello@yourdomain.com>

# Square (leave blank to run without online payments)
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Only if your public webhook URL differs from SITE_URL/api/square/webhook
SQUARE_WEBHOOK_URL=
